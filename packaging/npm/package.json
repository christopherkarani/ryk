{
  "name": "@rykan/ryk",
  "version": "1.2.12",
  "description": "npm launcher for the Zig-built ryk binary (Rykan V).",
  "license": "Apache-2.0",
  "homepage": "https://github.com/christopherkarani/ryk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christopherkarani/ryk.git"
  },
  "bin": {
    "ryk": "bin/ryk.js"
  },
  "scripts": {
    "postinstall": "node bin/ryk.js --install",
    "checksum:note": "node -e \"console.log('Release automation replaces PLACEHOLDER checksums before publish')\""
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "bin",
    "README.md"
  ],
  "ryk": {
    "artifactBaseUrl": "https://github.com/christopherkarani/ryk/releases/download/v1.2.12",
    "supportedTargets": [
      "darwin-amd64",
      "darwin-arm64",
      "linux-amd64",
      "linux-arm64",
      "windows-amd64"
    ],
    "checksums": {
      "darwin-amd64": "PLACEHOLDER_DARWIN_AMD64_SHA256",
      "darwin-arm64": "PLACEHOLDER_DARWIN_ARM64_SHA256",
      "linux-amd64": "PLACEHOLDER_LINUX_AMD64_SHA256",
      "linux-arm64": "PLACEHOLDER_LINUX_ARM64_SHA256",
      "windows-amd64": "PLACEHOLDER_WINDOWS_AMD64_SHA256"
    }
  }
}
