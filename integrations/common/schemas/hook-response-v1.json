{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ryk.local/schemas/hook-response-v1.json",
  "title": "ryk Hook Response v1",
  "description": "JSON response emitted by the ryk hook command to stdout.",
  "type": "object",
  "required": ["version", "decision", "risk", "category", "reason", "message"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Schema version. Must be 1."
    },
    "decision": {
      "type": "string",
      "enum": ["allow", "block", "warn", "ask", "context_only", "error"],
      "description": "Host-actionable decision."
    },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical", "unknown"],
      "description": "Risk level assessed by ryk."
    },
    "category": {
      "type": "string",
      "enum": ["command", "file", "file.read", "file.write", "file_read", "file_write", "env", "prompt", "tool", "network", "mcp", "unknown"],
      "description": "Decision category."
    },
    "reason": {
      "type": "string",
      "description": "Machine-readable reason code or explanation."
    },
    "rule": {
      "type": ["string", "null"],
      "description": "Matched policy rule identifier, if any."
    },
    "rule_id": {
      "type": ["string", "null"],
      "description": "Explicit machine-facing alias of rule."
    },
    "message": {
      "type": "string",
      "description": "Short agent-facing reason (prefer one line). Operator Recourse/Next live on stderr and in remediation_commands/suggestions, not in this field."
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "reason"],
        "properties": {
          "field": { "type": "string" },
          "reason": { "type": "string" }
        }
      },
      "description": "List of redacted fields and reasons."
    },
    "host_limitations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Honest notes about host enforcement limits."
    },
    "suggestions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional human-readable remediation tips from the evaluator."
    },
    "remediation_commands": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional safe next-step CLI commands (explain / allow-once / allowlist)."
    }
  },
  "additionalProperties": false
}
